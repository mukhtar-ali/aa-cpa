{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"],
            "env": [
                "BASE_URL",
                "SUPER_ADMIN_EMAIL",
                "SUPER_ADMIN_USERNAME",
                "SUPER_ADMIN_FULL_NAME",
                "SUPER_ADMIN_PASSWORD"
            ]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "db:generate": {
            "cache": false
        },
        "start": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        }
    }
}
