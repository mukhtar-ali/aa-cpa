node-linker=hoisted
shamefully-hoist=true
package-import-method=hardlink
store-dir=/mnt/e/.pnpm-store/v3

# This repo is worked on from both Windows PowerShell (installs) and WSL2 (some builds/
# checks). pnpm only fetches platform-native optional deps (e.g. @rollup/rollup-*) for
# the OS the install ran on by default, so a PowerShell install silently drops the Linux
# binary WSL needs (and vice versa) — breaking tsup/vite builds on whichever side didn't
# just install. Fetching both keeps either side working after any install.
supportedArchitectures.os[]=win32
supportedArchitectures.os[]=linux
supportedArchitectures.libc[]=glibc
