# Copy to /etc/aacpa/backup.env (chmod 600). Never commit the filled-in file.
RESTIC_REPOSITORY=s3:https://s3.me-central-1.amazonaws.com/CHANGE_ME_bucket/production
RESTIC_PASSWORD=CHANGE_ME_long_random
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
APP_DIR=/home/deploy/app
BACKUP_ENV=production
HEARTBEAT_URL=
KEEP_DAILY=30
KEEP_MONTHLY=12
