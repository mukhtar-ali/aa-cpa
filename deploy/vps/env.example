# Server-side .env for the self-hosted (non-Coolify) deployment. Lives only on the VPS, next to docker-compose.yml.
#   cp env.example .env && chmod 600 .env
# Never commit the filled-in file. Generate secrets with: openssl rand -hex 32

# Where the workflow pushes the images (lowercase): ghcr.io/<github-owner>/<repo>
IMAGE_PREFIX=ghcr.io/CHANGE_ME_owner/CHANGE_ME_repo
# Set by the deploy workflow on every release (to roll back, put an older commit SHA here and run `docker compose up -d`).
IMAGE_TAG=latest

# Public hostnames: DNS A records for all three must point at this server.
WEB_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# MySQL (the container is only reachable from the compose network). Keep MYSQL_PASSWORD URL-safe (letters, digits, - _ . ~).
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=nest_next_starter
MYSQL_USER=app_user
MYSQL_PASSWORD=CHANGE_ME

# API secrets
JWT_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
LOG_LEVEL=info
# SWAGGER_ENABLED=true

# One-off seeding: docker compose run --rm api pnpm seed
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_FULL_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=CHANGE_ME_StrongPass!123

# Fallback SMTP (admin Settings → Email overrides it once saved)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
EMAIL_FROM=noreply@example.com
SUPPORT_EMAIL=support@example.com

# S3 for uploads. Leave these four empty to store uploads on the server's disk (the api_uploads volume).
S3_BUCKET_NAME=
S3_BUCKET_ACCESS_KEY_ID=
S3_BUCKET_SECRET_ACCESS_KEY=
S3_BUCKET_REGION=
