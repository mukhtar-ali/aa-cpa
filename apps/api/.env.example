APP_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Swagger UI (/api/swagger) is enabled outside production by default; in production it is disabled unless explicitly set to "true".
# SWAGGER_ENABLED=true
DATABASE_URL="mysql://root:password@localhost:3306/nest_next_starter"
# In production, JWT_SECRET must be at least 32 random characters and not a placeholder (e.g. openssl rand -hex 32).
JWT_SECRET="change-me-to-a-long-random-string"
# Optional — falls back to JWT_SECRET when omitted (see apps/api/src/config/custom-env.ts).
# When set explicitly in production, CSRF_SECRET must also be at least 32 random characters and not a placeholder.
CSRF_SECRET=

# Auth rate limit (dev/QA/e2e only; ignored when NODE_ENV=production; default: 10 attempts per 15 minutes)
# AUTH_THROTTLE_LIMIT=500

# Seed (pnpm --filter @repo/api seed) — creates the initial super-admin user.
# No default is baked into the seed script; SUPER_ADMIN_PASSWORD is required.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_FULL_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=

# Mail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=

# URLs (in production, both ADMIN_PORTAL_URL and FRONTEND_URL must be explicitly set to the real http(s) origins for the CORS allow-list)
ADMIN_PORTAL_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# CPA / Web revalidation, preview, spam & estimator
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=
PREVIEW_SECRET=
TURNSTILE_SECRET=
ESTIMATOR_ALLOW_DRAFT=false
IP_HASH_PEPPER=
WEB_URL=http://localhost:3000

# File storage. Uploads (images, PDFs, applicants' résumés) go to S3 when S3_BUCKET_NAME is set, otherwise to this server's
# disk. Force one with STORAGE_DRIVER=local|s3.
# - local: files live under UPLOADS_DIR (default <api folder>/storage; mount a persistent volume on it and back it up).
#   Public files are served at <API_PUBLIC_URL>/uploads/...; résumés are never public and are opened by admins through
#   short-lived signed links. API_PUBLIC_URL is the public URL of THIS api (required in production with local storage).
# STORAGE_DRIVER=local
# UPLOADS_DIR=
# API_PUBLIC_URL=http://localhost:3001

# S3
S3_BUCKET_NAME=
S3_BUCKET_ACCESS_KEY_ID=
S3_BUCKET_SECRET_ACCESS_KEY=
S3_BUCKET_REGION=

# Reverse proxy: number of proxy hops to trust for X-Forwarded-For (e.g. 1 behind Coolify/Traefik or a single
# nginx). Without it every request appears to come from the proxy's IP, so the per-IP auth rate limit
# (10 attempts / 15 min) applies to ALL users together. Only an integer 1-10 is accepted ('true'/'*' are refused).
# TRUST_PROXY=1

# S3 object ACL: public-read (default) | private | none.
# Use "none" for buckets with "Bucket owner enforced" object ownership (the default for new AWS buckets) and for
# S3-compatible stores (Cloudflare R2, MinIO): they reject any ACL with AccessControlListNotSupported. Make the
# objects public through the bucket policy instead. "private" keeps uploads unreadable without a signed URL.
# Applicants' résumés are stored under nest-next-starter/private/ with no public ACL and shown to admins through 15-minute
# signed links: only expose nest-next-starter/uploads/* publicly through the bucket policy / CDN, never the whole bucket.
# S3_OBJECT_ACL=public-read
# NOTE: with "private" the URL returned for an upload is not directly readable; ResourceService.signedReadUrl makes a link.
#
# S3-compatible stores (Cloudflare R2, MinIO): set the endpoint, and for MinIO path-style addressing. The returned
# object links use S3_PUBLIC_BASE_URL when set (an R2 public domain, a CDN, ...), otherwise the AWS S3 URL.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://cdn.example.com
