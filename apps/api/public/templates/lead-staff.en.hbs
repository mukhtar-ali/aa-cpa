<!DOCTYPE html>
<html dir="ltr" lang="en">
<head><meta charset="utf-8"><title>New Contact Request</title></head>
<body style="font-family: Arial, sans-serif; color: #1a202c;">
  <h2>New Contact Request — Ahmad Abdullah CPA</h2>
  <p><strong>Full Name:</strong> {{fullName}}</p>
  {{#if company}}<p><strong>Company:</strong> {{company}}</p>{{/if}}
  <p><strong>Mobile:</strong> {{mobile}}</p>
  <p><strong>Email:</strong> {{email}}</p>
  <p><strong>Message:</strong></p>
  <blockquote style="background: #f7fafc; padding: 12px; border-left: 4px solid #1e3a8a;">{{message}}</blockquote>
</body>
</html>
