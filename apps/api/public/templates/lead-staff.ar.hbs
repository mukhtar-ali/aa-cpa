<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head><meta charset="utf-8"><title>طلب تواصل جديد</title></head>
<body style="font-family: Tahoma, Arial, sans-serif; direction: rtl; text-align: right; color: #1a202c;">
  <h2>طلب تواصل جديد — مكتب أحمد بن عبدالله للمحاسبة القانونية</h2>
  <p><strong>الاسم:</strong> {{fullName}}</p>
  {{#if company}}<p><strong>المنشأة:</strong> {{company}}</p>{{/if}}
  <p><strong>الجوال:</strong> {{mobile}}</p>
  <p><strong>البريد الإلكتروني:</strong> {{email}}</p>
  <p><strong>الرسالة:</strong></p>
  <blockquote style="background: #f7fafc; padding: 12px; border-right: 4px solid #1e3a8a;">{{message}}</blockquote>
</body>
</html>
