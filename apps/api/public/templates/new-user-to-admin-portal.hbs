<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to the Admin Portal</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5;padding:32px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden;">
                    <tr>
                        <td style="padding:32px;">
                            <h1 style="margin:0 0 16px;font-size:20px;color:#111827;">Welcome to the Admin Portal</h1>
                            <p style="margin:0 0 16px;font-size:14px;line-height:1.6;color:#374151;">
                                Hi {{fullName}}, an account has been created for you.
                            </p>
                            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px;font-size:14px;color:#374151;">
                                <tr><td style="padding:4px 0;"><strong>Email:</strong></td><td style="padding:4px 0 4px 8px;">{{email}}</td></tr>
                                <tr><td style="padding:4px 0;"><strong>Username:</strong></td><td style="padding:4px 0 4px 8px;">{{username}}</td></tr>
                                <tr><td style="padding:4px 0;"><strong>Temporary password:</strong></td><td style="padding:4px 0 4px 8px;">{{tempPassword}}</td></tr>
                            </table>
                            <p style="margin:0 0 24px;font-size:14px;line-height:1.6;color:#374151;">
                                Please sign in and change your password as soon as possible.
                            </p>
                            <p style="margin:0 0 24px;text-align:center;">
                                <a href="{{loginUrl}}" style="display:inline-block;padding:10px 20px;background-color:#111827;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;">Sign In</a>
                            </p>
                            <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;">
                                Questions? Contact <a href="mailto:{{supportEmail}}" style="color:#6b7280;">{{supportEmail}}</a>.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
