generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum Language {
  en
  ar
}

enum OtpType {
  forget_password
}

enum SectionType {
  website_info          @map("website-info")
  home_hero             @map("home-hero")
  home_about            @map("home-about")
  fonts
  home_why              @map("home-why")
  site_chrome           @map("site-chrome")
  page_home             @map("page-home")
  page_about            @map("page-about")
  page_services         @map("page-services")
  service_shared        @map("service-shared")
  page_sectors          @map("page-sectors")
  page_articles         @map("page-articles")
  page_careers          @map("page-careers")
  page_contact          @map("page-contact")
  legal_privacy         @map("legal-privacy")
  legal_terms           @map("legal-terms")
  legal_accessibility   @map("legal-accessibility")
  estimator_config      @map("estimator-config")
  notification_settings @map("notification-settings")
  spam_settings         @map("spam-settings")
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
  cooperative_training
}

enum JobApplicationStatus {
  pending
  reviewed
  shortlisted
  interview
  offer
  hired
  rejected
}

enum FaqScope {
  global
  contact
  service
}

enum RedirectType {
  permanent
  temporary
}

enum RedirectSource {
  manual
  legacy_import
  slug_change
}

enum ContactSource {
  contact
  estimator
  service_page
}

enum ContactStatus {
  new
  contacted
  qualified
  closed
  spam
}

enum ConsentSubjectType {
  contact
  application
  quote
}

enum OutboxKind {
  email
  revalidate
}

enum OutboxStatus {
  pending
  sending
  sent
  failed
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id                  String    @id @default(uuid())
  fullName            String    @db.VarChar(100)
  email               String    @unique @db.VarChar(100)
  username            String    @unique @db.VarChar(100)
  password            String    @db.VarChar(255)
  isActive            Boolean   @default(true)
  permissions         Json      @default("[]")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  isDeleted           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  otps                 UserOtp[]
  loginAttempts        LoginAttempt[]
  refreshTokens        RefreshToken[]
  assignedContacts     Contact[]        @relation("AssignedContacts")
  assignedApplications JobApplication[] @relation("AssignedApplications")
  createdRedirects     Redirect[]       @relation("UserRedirects")

  @@map("users")
}

model UserOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp       String   @db.VarChar(6)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  type      OtpType
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_otps")
}

model LoginAttempt {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String   @db.VarChar(100)
  success       Boolean
  ipAddress     String   @db.VarChar(45)
  userAgent     String?  @db.VarChar(500)
  failureReason String?  @db.VarChar(255)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  rotatedAt DateTime?

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================
// Services & Sectors
// ============================================================

model Service {
  id           String    @id @default(uuid())
  slug         String    @unique @db.VarChar(120)
  image        Json?
  heroImage    Json?
  icon         String?   @db.VarChar(100)
  highlight    Json?
  methodology  Json      @default("[]")
  deliverables Json      @default("[]")
  order        Int       @default(0)
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  ogImage      Json?
  noindex      Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  translations ServiceTranslation[]
  sectors      ServiceSector[]
  articles     ArticleService[]
  faqs         FaqItem[]
  contacts     Contact[]

  @@index([isPublished, isDeleted])
  @@index([order])
  @@map("services")
}

model ServiceTranslation {
  id              String   @id @default(uuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  language        Language
  title           String   @db.VarChar(255)
  summary         String   @db.Text
  heroSubtitle    String?  @db.VarChar(500)
  statement       String?  @db.Text
  audience        String?  @db.Text
  whyUs           String?  @db.Text
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text

  @@unique([serviceId, language])
  @@map("service_translations")
}

model Sector {
  id          String    @id @default(uuid())
  slug        String    @unique @db.VarChar(120)
  icon        String?   @db.VarChar(100)
  featured    Boolean   @default(false)
  bandImage   Json?
  order       Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  translations SectorTranslation[]
  services     ServiceSector[]
  articles     ArticleSector[]

  @@index([isPublished, isDeleted])
  @@index([order])
  @@map("sectors")
}

model SectorTranslation {
  id              String   @id @default(uuid())
  sectorId        String
  sector          Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  language        Language
  title           String   @db.VarChar(255)
  summary         String   @db.Text
  bandTitle       String?  @db.VarChar(255)
  bandBody        String?  @db.Text
  bandCtaLabel    String?  @db.VarChar(100)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text

  @@unique([sectorId, language])
  @@map("sector_translations")
}

model ServiceSector {
  serviceId String
  sectorId  String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sector    Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([serviceId, sectorId])
  @@map("service_sectors")
}

// ============================================================
// Articles (News), Categories & Authors
// ============================================================

model ArticleCategory {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(120)
  name        Json
  order       Int      @default(0)
  isCaseStory Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles News[]

  @@index([order])
  @@map("article_categories")
}

model Author {
  id        String   @id @default(uuid())
  name      Json
  role      Json
  bio       Json
  avatar    Json?
  order     Int      @default(0)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles News[]

  @@index([order])
  @@map("authors")
}

model News {
  id             String           @id @default(uuid())
  slug           String?          @unique @db.VarChar(300)
  coverImage     Json?            @map("thumbnail")
  categoryId     String
  category       ArticleCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId       String?
  author         Author?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  readingMinutes Int?
  tags           Json             @default("[]")
  isPublished    Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  publishedAt    DateTime?
  ogImage        Json?
  noindex        Boolean          @default(false)
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  translations NewsTranslation[]
  sectors      ArticleSector[]
  services     ArticleService[]

  @@index([isPublished, isDeleted])
  @@index([categoryId, isPublished])
  @@index([isFeatured, isPublished])
  @@index([publishedAt])
  @@map("news")
}

model NewsTranslation {
  id              String   @id @default(uuid())
  newsId          String
  news            News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  language        Language
  title           String   @db.VarChar(255)
  excerpt         String?  @db.Text
  body            String?  @db.LongText
  tocEnabled      Boolean  @default(true)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text

  @@unique([newsId, language])
  @@map("news_translations")
}

model ArticleSector {
  articleId String
  sectorId  String
  article   News   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sector    Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([articleId, sectorId])
  @@map("article_sectors")
}

model ArticleService {
  articleId String
  serviceId String
  article   News    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([articleId, serviceId])
  @@map("article_services")
}

// ============================================================
// Careers & Jobs
// ============================================================

model JobDepartment {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(120)
  name      Json
  order     Int      @default(0)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([order])
  @@map("job_departments")
}

model Office {
  id             String    @id @default(uuid())
  city           Json
  address        Json
  mapUrl         String?   @db.VarChar(500)
  mapX           Int?
  mapY           Int?
  image          Json?
  isHeadquarters Boolean   @default(false)
  order          Int       @default(0)
  isPublished    Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  jobs Job[]

  @@index([order])
  @@map("offices")
}

model Job {
  id               String         @id @default(uuid())
  slug             String?        @unique @db.VarChar(300)
  departmentId     String
  department       JobDepartment  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officeId         String?
  office           Office?        @relation(fields: [officeId], references: [id], onDelete: SetNull)
  employmentType   EmploymentType @default(full_time)
  experienceMin    Int?
  experienceMax    Int?
  closesAt         DateTime?
  responsibilities Json           @default("[]")
  requirements     Json           @default("[]")
  benefits         Json           @default("[]")
  order            Int            @default(0)
  isPublished      Boolean        @default(false)
  publishedAt      DateTime?
  ogImage          Json?
  noindex          Boolean        @default(false)
  isDeleted        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  translations JobTranslation[]
  applications JobApplication[]

  @@index([isPublished, isDeleted])
  @@index([departmentId, isPublished])
  @@index([closesAt])
  @@index([order])
  @@map("jobs")
}

model JobTranslation {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  language        Language
  title           String   @db.VarChar(255)
  summary         String?  @map("description") @db.Text
  body            String?  @db.LongText
  location        String?  @db.VarChar(255)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text

  @@unique([jobId, language])
  @@map("job_translations")
}

model JobApplication {
  id           String               @id @default(uuid())
  jobId        String
  job          Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName     String               @db.VarChar(100)
  email        String               @db.VarChar(255)
  mobile       String               @db.VarChar(50)
  linkedinUrl  String?              @db.VarChar(500)
  motivation   String?              @db.Text
  resumeKey    String               @db.VarChar(255)
  resumeName   String               @db.VarChar(255)
  resumeSize   Int
  language     Language             @default(ar)
  status       JobApplicationStatus @default(pending)
  assignedToId String?
  assignedTo   User?                @relation("AssignedApplications", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        Json                 @default("[]")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([jobId, status])
  @@index([status, createdAt])
  @@index([email])
  @@index([assignedToId])
  @@map("job_applications")
}

// ============================================================
// Reference Entities (Testimonials, Logos, Credentials, FAQs, Redirects)
// ============================================================

model Testimonial {
  id          String    @id @default(uuid())
  quote       Json
  rating      Int?
  name        Json
  role        Json
  company     Json?
  avatar      Json?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  placement   Json      @default("[\"home\"]")
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([order])
  @@map("testimonials")
}

model ClientLogo {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(255)
  logo        Json
  url         String?   @db.VarChar(500)
  row         Int       @default(1)
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([row, order])
  @@map("client_logos")
}

model Credential {
  id          String    @id @default(uuid())
  name        Json
  logo        Json
  url         String?   @db.VarChar(500)
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([order])
  @@map("credentials")
}

model FaqItem {
  id          String    @id @default(uuid())
  question    Json
  answer      Json
  scope       FaqScope  @default(global)
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([scope, order])
  @@index([serviceId])
  @@map("faq_items")
}

model Redirect {
  id          String         @id @default(uuid())
  fromPath    String         @unique @db.VarChar(500)
  toPath      String         @db.VarChar(500)
  type        RedirectType   @default(permanent)
  source      RedirectSource @default(manual)
  hits        Int            @default(0)
  lastHitAt   DateTime?
  createdById String?
  createdBy   User?          @relation("UserRedirects", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([source])
  @@index([createdById])
  @@map("redirects")
}

// ============================================================
// Leads (Contacts & Quotes)
// ============================================================

model Contact {
  id               String        @id @default(uuid())
  fullName         String        @db.VarChar(100)
  company          String?       @db.VarChar(150)
  mobile           String        @db.VarChar(20)
  email            String        @db.VarChar(100)
  serviceId        String?
  service          Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  message          String?       @db.Text
  source           ContactSource @default(contact)
  estimatorAnswers Json?
  estimatedRange   Json?
  language         Language      @default(ar)
  landingPath      String?       @db.VarChar(500)
  status           ContactStatus @default(new)
  assignedToId     String?
  assignedTo       User?         @relation("AssignedContacts", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes            Json          @default("[]")
  isDeleted        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@index([status, isDeleted])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("contacts")
}

// ============================================================
// Privacy & Compliance (Consent Records, Outbox, Erasure Logs)
// ============================================================

model ConsentRecord {
  id            String             @id @default(uuid())
  subjectType   ConsentSubjectType
  subjectId     String             @db.VarChar(36)
  email         String             @db.VarChar(255)
  purpose       String             @db.VarChar(100)
  policyVersion String             @db.VarChar(50)
  language      Language           @default(ar)
  ipHash        String             @db.VarChar(64)
  userAgent     String             @db.VarChar(255)
  consentedAt   DateTime           @default(now())

  @@index([email])
  @@index([subjectType, subjectId])
  @@map("consent_records")
}

model EmailOutbox {
  id            String       @id @default(uuid())
  kind          OutboxKind   @default(email)
  template      String?      @db.VarChar(100)
  to            String?      @db.VarChar(255)
  language      Language     @default(ar)
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?      @db.Text
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model ErasureLog {
  id            String   @id @default(uuid())
  emailHash     String   @db.VarChar(64)
  requestedById String   @db.VarChar(36)
  itemsErased   Json
  at            DateTime @default(now())

  @@index([emailHash])
  @@map("erasure_logs")
}

// ============================================================
// Sections (CMS singletons) & SEO
// ============================================================

model Section {
  id        String   @id @default(uuid())
  type      String   @unique @db.VarChar(100)
  data      Json
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

model Seo {
  id        String   @id @default(uuid())
  pageKey   String   @unique @db.VarChar(255)
  content   Json
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo")
}

// ============================================================
// Monitoring
// ============================================================

model MonitoringMetric {
  id        String   @id @default(uuid())
  sessionId String   @db.VarChar(36)
  type      String   @db.VarChar(20)
  name      String   @db.VarChar(100)
  value     Float
  rating    String?  @db.VarChar(30)
  page      String   @db.VarChar(500)
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId])
  @@index([createdAt])
  @@map("monitoring_metrics")
}

model MonitoringError {
  id        String   @id @default(uuid())
  sessionId String   @db.VarChar(36)
  type      String   @db.VarChar(30)
  message   String   @db.VarChar(1000)
  stack     String?  @db.Text
  context   String   @db.Text
  page      String   @db.VarChar(500)
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId])
  @@index([createdAt])
  @@map("monitoring_errors")
}

model MonitoringEvent {
  id         String   @id @default(uuid())
  sessionId  String   @db.VarChar(36)
  type       String   @db.VarChar(20)
  name       String   @db.VarChar(100)
  properties String?  @db.Text
  page       String   @db.VarChar(500)
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@index([name, timestamp])
  @@index([sessionId])
  @@index([createdAt])
  @@map("monitoring_events")
}

model MonitoringMetricRollup {
  id        String   @id @default(uuid())
  period    String   @db.VarChar(10)
  periodKey String   @db.VarChar(30)
  type      String   @db.VarChar(20)
  count     Int
  p50       Float
  p75       Float
  p90       Float
  min       Float
  max       Float
  createdAt DateTime @default(now())

  @@unique([period, periodKey, type])
  @@index([period, type])
  @@map("monitoring_metric_rollups")
}

model MonitoringEventRollup {
  id        String   @id @default(uuid())
  period    String   @db.VarChar(10)
  periodKey String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  count     Int
  createdAt DateTime @default(now())

  @@unique([period, periodKey, name])
  @@index([period, name])
  @@map("monitoring_event_rollups")
}

model MonitoringErrorRollup {
  id        String   @id @default(uuid())
  period    String   @db.VarChar(10)
  periodKey String   @db.VarChar(30)
  type      String   @db.VarChar(30)
  count     Int
  createdAt DateTime @default(now())

  @@unique([period, periodKey, type])
  @@index([period, type])
  @@map("monitoring_error_rollups")
}
