{
    "name": "@repo/api",
    "version": "0.0.1",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "prisma generate && nest build",
        "dev": "prisma generate && nest start --watch",
        "start": "node dist/main",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "check-types": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tools.json",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:push": "prisma db push",
        "seed": "ts-node -P tsconfig.json -r tsconfig-paths/register prisma/seed.ts",
        "admin:reset-password": "ts-node -P tsconfig.json -r tsconfig-paths/register prisma/reset-admin-password.ts",
        "fix:sections-gr-to-ar": "ts-node -P tsconfig.json -r tsconfig-paths/register prisma/fix-section-gr-to-ar.ts",
        "content:audit": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/content-audit.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1166.0",
        "@aws-sdk/s3-request-presigner": "^3.1166.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/client": "^6.0.0",
        "@repo/shared": "workspace:*",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "csrf-csrf": "^4.0.3",
        "dotenv": "^17.2.4",
        "handlebars": "^4.7.10",
        "lodash": "^4.17.23",
        "nestjs-i18n": "^10.6.0",
        "nestjs-pino": "^4.4.0",
        "nestjs-zod": "^5.1.1",
        "nodemailer": "^10.0.6",
        "pino-http": "^10.5.0",
        "prisma": "^6.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sanitize-html": "^2.14.0",
        "sharp": "^0.35.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.23",
        "@types/multer": "^1.4.12",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.2",
        "@types/sanitize-html": "^2.13.0",
        "jest": "^30.5.2",
        "pino-pretty": "^13.0.0",
        "ts-jest": "^29.4.15"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "tsconfig": {
                        "allowJs": true
                    }
                }
            ]
        },
        "transformIgnorePatterns": [
            "node_modules/(?!(?:\\.pnpm/)?(uuid|htmlparser2|domelementtype|domhandler|domutils|dom-serializer|entities|is-plain-object|escape-string-regexp|parse-srcset))"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
