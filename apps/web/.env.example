BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Used for absolute URLs in sitemap.xml / canonical/OG tags — set to the real public domain
# in production (e.g. https://example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional — Meta (Facebook) Pixel. Leave blank to disable; <FBPixel> renders nothing without it.
NEXT_PUBLIC_FB_PIXEL_ID=
# Set to "false" to turn off the built-in Web Vitals / error / page-view reporting to the API
# (POST /api/monitoring). It is also skipped for visitors who send Do Not Track or Global Privacy Control.
# NEXT_PUBLIC_MONITORING_ENABLED=true
