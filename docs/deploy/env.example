# =============================================================================
# Root Docker Compose & Deployment Environment Template
# Copy to the repository root as `.env` before running `docker compose`:
#   cp docs/deploy/env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Host Port Mappings (Docker Compose)
# -----------------------------------------------------------------------------
MYSQL_PORT=3306
API_PORT=3001
ADMIN_PORT=3002
WEB_PORT=3000

# -----------------------------------------------------------------------------
# MySQL 8.0 Container Credentials
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=nest_next_starter
MYSQL_USER=app_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# -----------------------------------------------------------------------------
# API Runtime Configuration (@repo/api)
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_PORT=3001
LOG_LEVEL=info

# Inside Docker Compose, the MySQL service hostname is `mysql` (not `localhost`).
# Compose builds the api DATABASE_URL from MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE (see docker-compose.yml).
# Keep MYSQL_PASSWORD URL-safe (letters, digits, - _ . ~) or percent-encode it. Only set DATABASE_URL below when NOT using compose.
# DATABASE_URL="mysql://app_user:CHANGE_ME_DB_PASSWORD@mysql:3306/nest_next_starter"

# Secrets — replace with strong random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Optional: defaults to JWT_SECRET when empty (see apps/api/src/config/custom-env.ts)
CSRF_SECRET=CHANGE_ME_CSRF_SECRET

# NOTE: AUTH_THROTTLE_LIMIT is strictly ignored when NODE_ENV=production
# (apps/api/src/auth/auth-throttle.ts enforces 10 attempts per 15 minutes in production).
# Only effective in development/QA/e2e when NODE_ENV != production.
# AUTH_THROTTLE_LIMIT=500

# Behind a reverse proxy (Coolify/Traefik, nginx, a load balancer): number of proxy hops to trust for
# X-Forwarded-For, an integer 1-10. Without it every request appears to come from the proxy's IP, so the
# per-IP auth limit applies to ALL users together. Leave unset when the API is exposed directly.
# TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Initial Super-Admin Seed (`docker compose run --rm api pnpm seed`)
# Note: Seeding does NOT run automatically on container startup.
# SUPER_ADMIN_PASSWORD is required when seeding and must pass password complexity:
# >=8 chars, uppercase, lowercase, number, and special character (!@#$%^&*).
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_FULL_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=CHANGE_ME_StrongPass!123

# -----------------------------------------------------------------------------
# CORS & Application Origins (@repo/api)
# Exact origins (scheme + host + port, no trailing slash) allowed by API CORS
# (`apps/api/src/main.ts` sets `credentials: true` with `[ADMIN_PORTAL_URL, FRONTEND_URL]`).
# -----------------------------------------------------------------------------
ADMIN_PORTAL_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SMTP / Email Settings (@repo/api — fallback when DB section `email-settings` is unset)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=CHANGE_ME_SMTP_USER
EMAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM=noreply@example.com
SUPPORT_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# S3 Object Storage (@repo/api — image & PDF resume uploads)
# -----------------------------------------------------------------------------
# Files go to S3 when S3_BUCKET_NAME is set. NO S3? Empty the four S3_* lines below (or delete them) and uploads are
# stored on this server's disk instead (a Docker volume, see docker-compose.yml; back it up). In that case set
# API_PUBLIC_URL to the public URL of the API (it is baked into the stored file links).
API_PUBLIC_URL=http://localhost:3001
# STORAGE_DRIVER=local   # or s3: forces one regardless of the S3_* values
S3_BUCKET_NAME=CHANGE_ME_S3_BUCKET
S3_BUCKET_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY_ID
S3_BUCKET_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY
S3_BUCKET_REGION=us-east-1

# -----------------------------------------------------------------------------
# Admin Portal Build-Time Variables (@repo/admin)
# Baked into the static Vite bundle during `vite build`.
# Must be the browser-reachable URL of the API (no trailing slash).
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Public Storefront Build-Time & Runtime Variables (@repo/web)
# Turned into ENV before `next build` in apps/web/Dockerfile.
# Note: `apps/web/next.config.ts` inlines `BASE_URL` at build time for both
# Server Components and Client Components (`useMutation` on contact/career forms).
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FB_PIXEL_ID=
