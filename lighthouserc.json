{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/ar",
        "http://localhost:3000/en",
        "http://localhost:3000/ar/about",
        "http://localhost:3000/ar/services",
        "http://localhost:3000/ar/services/external-audit",
        "http://localhost:3000/ar/sectors",
        "http://localhost:3000/ar/articles",
        "http://localhost:3000/ar/articles/saudi-corporate-tax-guide-2026",
        "http://localhost:3000/ar/careers",
        "http://localhost:3000/ar/careers/senior-audit-associate",
        "http://localhost:3000/ar/contact",
        "http://localhost:3000/ar/privacy",
        "http://localhost:3000/ar/terms",
        "http://localhost:3000/ar/accessibility"
      ],
      "numberOfRuns": 1,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-report"
    }
  }
}
