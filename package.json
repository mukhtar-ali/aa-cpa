{
    "name": "nest-next-starter",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev --concurrency=25",
        "start": "turbo run start --concurrency=25",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types",
        "test": "turbo run test",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.63.0",
        "prettier": "^3.7.4",
        "turbo": "^2.8.3",
        "typescript": "^5"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=22"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.61.1"
    },
    "pnpm": {
        "supportedArchitectures": {
            "os": [
                "current",
                "linux"
            ],
            "cpu": [
                "current"
            ],
            "libc": [
                "glibc"
            ]
        },
        "overrides": {
            "@swc/helpers": "^0.5.17",
            "@ckeditor/ckeditor5-engine": ">=47.7.4",
            "body-parser": ">=2.4.0",
            "browserslist": ">=4.28.7",
            "deepmerge-ts": ">=8.0.0",
            "effect": "^3.22.1",
            "follow-redirects": ">=1.16.2",
            "form-data": ">=4.0.6",
            "immutable": ">=5.1.8",
            "js-yaml": ">=4.3.2",
            "multer": ">=2.5.0",
            "nanoid": ">=3.3.18",
            "postcss": ">=8.5.18",
            "proxy-addr": ">=2.0.8",
            "seroval": ">=1.6.8",
            "source-map-js": ">=1.2.2",
            "zod": ">=4.6.6"
        }
    }
}
